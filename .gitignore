# Git rules only; this does NOT configure Nutstore exclusions.
__pycache__/
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
.codexprism/
.prism/

# Local manuscripts, research sources and machine-specific state.
/papers/
/research-inputs/
/incoming/
/reviews/
/CONTINUE.md
/standards/author-papers/
**/references/author-papers/*.pdf
/tests/
**/references/author-papers/*.pdf
/tests/
/.agents/
/.codex/
/.aws/
*.zip
*.exe
*.msi
*.dmg
*.app/
.DS_Store
Thumbs.db
node_modules/
.venv/
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Desktop source backup: never track runtime/research/build data.
**/target/
**/dist/
**/coverage/
**/.mps/
**/.prism/
**/.codexprism/
*.tsbuildinfo
*.icns.bak

# iPad/remote source publication: never include generated or owner-private state.
**/.build/
**/evidence/
**/*.mobileprovision
**/*.provisionprofile
**/*.entitlements
/desktop/apps/ipad/src-tauri/gen/
/desktop/apps/ipad/src-tauri/icons/
/desktop/apps/remote/config.local.json
/desktop/apps/remote/runtime/
